= render 'front/portal/header'
.p-portal
  .inner.container
    .row.container
      .events-wrapper.col-8
        .scheduled-event-wrapper
          .scheduled-event-header
            %h2 今後開催予定のイベント
          .scheduled-event-body
            %table
              - @events.each do |event|
                %tr
                  %td
                    %h3.title
                      = event.name
                    = link_to front_event_path(event.url_subdirectory) do
                      .event-image
                        = image_tag event.main_image.url, size: '300x200'
          .scheduled-event-footer
        .past-event-wrapper
          .past-event-header
            %h2 過去のイベント
          .past-event-body
            %table
              - @events.each do |event|
                %tr
                  %td
                    %h3.title
                      = event.name
                    = link_to front_event_path(event.url_subdirectory) do
                      .event-image
                        = image_tag event.main_image.url, size: '300x200'
          .past-event-footer
        
      .menu.col-4
        .menu-header
          %h2 メニュー
        .menu-body 
          %ul
            %li リンク1
            %li リンク2
            %li リンク3
        .menu-footer
    .row.container
