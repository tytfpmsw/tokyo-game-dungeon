.event-sponsor-body
  - sponsors.each do |sponsor|
    - if sponsor.url.present?
      %a{ :href => sponsor.url, :target => "_blank", :rel => "noopener noreferrer" }
        .content
          - if sponsor.image.present?
            = image_tag sponsor.image_url
          %h3= sponsor.name
    - else
      .content
        - if sponsor.image.present?
          = image_tag sponsor.image_url
        %h3= sponsor.name