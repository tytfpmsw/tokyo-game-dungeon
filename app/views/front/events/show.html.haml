= render 'front/events/header', event: @event
.p-event-show
  .inner
    .main-banner
      = image_tag @event.main_image.url, size: '1920x1080'
      
    = render 'front/shared/divider'

    .event-summary-wrapper
      .event-summary-header
        %h2 イベント概要
      .event-summary-body.container
        .row
          .left.col-6
            %h3 インディ開発者主催の<br/>インディゲーム展示会
            %p 東京ゲームダンジョンは国内の個人や小規模チームが制作するデジタル・ゲーム（インディゲーム）の展示会です。出展者は手頃な料金と充実した設備で、自作ゲームの魅力を伝えることができます。来場者は会場でゲームを試遊・購入したり、開発者と交流することができます。主催者も個人でゲームを作ってます。
          .right.col-6
            = image_tag 'tgd5_venue.jpg'

    = render 'front/shared/divider'

    .event-ticket-wrapper
      %a{ href: 'https://passmarket.yahoo.co.jp/event/show/detail/02ja1a7g6rt31.html', :target => '_blank', :rel => 'noopener noreferrer' }
        = image_tag 'Button_PassMarket_500x100.png', size: '500x100'

    = render 'front/shared/divider'

    - case Event.locations[@event.location]
    - when Event.locations[:hamamatsu_tsbc]
      = render 'news_hamamatsu_tsbc'
    - when Event.locations[:note_place]
      = render 'news_note_place'
    
    = render 'front/shared/divider'

    .event-recommend-wrapper
      %h2 （出展）こんな人におすすめ！
      .event-recommend-body
        .content
          .card
            .icon-box
              %i.fa-solid.fa-stopwatch.mb-2
            %h3 締切がほしい人
            %p 
              ゲームを完成させるために締切が欲しい！
              締切がないとダラけてしまうという方へ。
              作品がエターナりそうな場合は、出展申込して腹をくくりましょう！
        .content
          .card
            .icon-box
              %i.fa-solid.fa-eye.mb-2
            %h3 作品を見て欲しい人
            %p 
              自作ゲームをリーズナブルに宣伝したい！
              作品へのフィードバックがほしいという方へ。
              デカい机であなたの作品の魅力を存分にアピールしてください！
        .content
          .shakehands-icon
          .card
            .icon-box
              %i.fa-solid.fa-handshake.mb-2
            %h3 交流したい人
            %p 
              同じインディ開発者やインディゲーム好きとつながりたい！
              いろんな作品を見て刺激を受けたい方へ。
              周りにゲーム作ってる人がいなくてもここにはたくさんいます。
    
    = render 'front/shared/divider'
    
    - case Event.locations[@event.location]
    - when Event.locations[:hamamatsu_tsbc]
      = render 'feature_hamamatsu_tsbc'
    - when Event.locations[:note_place]
      = render 'feature_note_place'

    = render 'front/shared/divider'

    .event-venue-map-wrapper
      %h2 会場地図

      .map
        - case Event.locations[@event.location]
        - when Event.locations[:hamamatsu_tsbc]
          %iframe{ src: "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d12967.548422945705!2d139.760769!3d35.655153!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60188b60c0d52981%3A0x5db20f81d038f20c!2z5p2x5Lqs6YO956uL55Sj5qWt6LK_5piT44K744Oz44K_44O85rWc5p2-55S66aSo!5e0!3m2!1sja!2sjp!4v1712068976525!5m2!1sja!2sjp", width: "600", height: "450", style: "border:0;", allowfullscreen: "", loading: "lazy", referrerpolicy: "no-referrer-when-downgrade"}
        - when Event.locations[:note_place]
          %iframe{ src: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3240.647906486383!2d139.7294469116286!3d35.685670672471545!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60188d46d2e8b7ed%3A0x595355ca710fc19a!2snote%20place!5e0!3m2!1sja!2sjp!4v1714651046803!5m2!1sja!2sjp", width: "600", height:"450", style:"border:0;", allowfullscreen:"", loading: "lazy", referrerpolicy: "no-referrer-when-downgrade" }

    = render 'front/shared/divider'

    .event-sponsor-wrapper
      %h2 協賛
      = render 'sponsor', sponsors: @event.sponsors
      .event-sponsor-footer
        = image_tag 'Ruis0-1.gif'
        
    = render 'front/shared/divider'

    .event-organizer-wrapper
      %h2 主催
      .event-organizer-body
        .content
          = image_tag 'iwski.png'
          .organizer-name
            %h3 岩崎
            %p @iwski
          .organizer-info 
            %p 
              ゲーム会社で働いたことはないが、なぜかゲーム開発沼にハマる。<br/>
              2016年から<a href="https://indiegame.connpass.com/" target="_blank" rel="noopener noreferrer">ゲーム開発のもくもく会</a>を100回以上開催、2022年に東京ゲームダンジョンを立ち上げる。<br/>
              写真は愛犬のジョー。

    = render 'front/shared/divider'

    .event-contact-wrapper
      %h2 お問合せ
      .event-contact-body
        .content 
          = render 'front/events/form', event: @event, show_checkbox_recaptcha: @show_checkbox_recaptcha
        .content
          = image_tag 'Charlotte0-1.gif'
          