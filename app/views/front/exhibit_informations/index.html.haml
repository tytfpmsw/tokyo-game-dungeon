= render 'front/events/header', event: @event
.p-exhibit-informations-header
  %h1= "#{@event.name} 出展作品一覧"
= render 'navigation', { event_schedule: @event_schedule, floor: @floor, place_blocks: @place_blocks }
.p-exhibit-informations-map 
  - if @floor.present? && @floor.image.present?
    = image_tag(@floor.image_url, class: 'map-image')
  - else
    - if @event_schedule.floors.first.image.present?
      = image_tag(@event_schedule.floors.first.image_url, class: 'map-image')
.p-exhibit-informations-content
  - if @event.event_schedules.count >= 2 && @event.floors.count >= 2
    %h2= "#{@event_schedule.day_number_in_event}日目 #{@floor.name}"
  - elsif @event.event_schedules.count >= 2
    %h2= "#{@event_schedule.day_number_in_event}日目"
  - elsif @event.floors.count >= 2
    %h2= @floor.name
  - if !@exhibit_information_places.nil?
    - @place_blocks.each do |place_block|
      %h2{id: place_block.id}= place_block.name
      .row.exhibit-informations
        - @exhibit_information_places.where(place_block: place_block).order(:place_number).each do |eip|
          = render 'exhibit_information_panel', { exhibit_information: eip.exhibit_information, place_block: place_block, place_number: eip.place_number }
      = render 'front/shared/divider'
