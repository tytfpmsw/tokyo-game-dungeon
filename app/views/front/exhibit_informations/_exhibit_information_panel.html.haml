%a{ href: front_event_exhibit_information_path(exhibit_information.event.url_subdirectory, exhibit_information), data: { turbo_frame: 'modal' }, class: 'exhibit-information-panel' }
  - if exhibit_information.image.present?
    = image_tag exhibit_information.image_url, class: 'exhibit-image'
  - else
    = image_tag 'noimage.jpg', class: 'exhibit-image'
  %h2= exhibit_information.title.present? ? exhibit_information.title : '準備中'
  %p.place= "#{place_block.name}-#{place_number}"
  %p.circle-name= exhibit_information.circle_name