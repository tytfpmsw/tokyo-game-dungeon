= image_tag 'login_admin.png', size: '300x300', alt: '東京ゲームダンジョン管理者ログインページ' if admin?
= image_tag 'login_exhibitor.png', size: '300x300', alt: '東京ゲームダンジョン出展者ログインページ' if exhibitor?

= form_for resource, as: resource_name, url: session_path(resource_name) do |f|
  .row.justify-content-center
    .field.col-md-6.mb-4
      = f.label :email, "メールアドレス", class: "form-label"
      = f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control"
  .row.justify-content-center
    .field.col-md-6.mb-4
      = f.label :password, "パスワード", class: "form-label"
      = f.password_field :password, autocomplete: "current-password", class: "form-control"

    -# - if devise_mapping.rememberable?
    -#   .field.mb-4
    -#     = f.check_box :remember_me, class: "form-check-input"
    -#     = f.label :remember_me, "ログイン状態を維持する", class: "form-check-label"

    .actions
      = f.submit "ログイン", class: "btn btn-primary"
