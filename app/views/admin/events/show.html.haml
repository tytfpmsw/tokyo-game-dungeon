.p-admin-event-show 
  %h1
    = @event.name
  .row.justify-content-center
    .col-8.mg-auto.mb-4
      %table.border
        %tr
          %th ロゴ
          %td
            = image_tag @event.logo_image.url
        %tr
          %th メイン画像
          %td
            = image_tag @event.main_image.url, size: '300x300'
        %tr
          %th ステータス
          %td= @event.status
  = button_to 'ブロック編集', admin_event_place_blocks_path(@event), method: :get, class: 'btn btn-primary mg-auto mb-4'
  = button_to '出展者管理', admin_event_exhibitors_path(@event), method: :get, class: 'btn btn-primary mg-auto mb-4'
  = button_to '出展情報確認', admin_event_exhibit_submissions_path(@event), method: :get, class: 'btn btn-primary mg-auto mb-4'