= form_with url: admin_events_path do |f|
  %table
    %tr
      %th= f.label :name, 'イベント名'
      %td= f.text_field :name, value: @event&.name
    %tr
      %th= f.label :url_subdirectory, 'URLサブディレクトリ'
      %td= f.text_field :url_subdirectory, value: @event&.url_subdirectory
    %tr
      %th= f.label :location, '開催場所'
      %td= f.select :location, Event.locations.keys.map { |k| [t("activerecord.attributes.event/location.#{k}"), k] }, value: @event&.location
    %tr
      %th= f.label :start_at, 'イベント開始日時'
      %td= f.datetime_field :start_at
    %tr
      %th= f.label :end_at, 'イベント終了日時'
      %td= f.datetime_field :end_at
    %tr
      %th= f.label :logo_image, 'ロゴ画像'
      %td= f.file_field :logo_image
    %tr
      %th= f.label :main_image, 'メイン画像'
      %td= f.file_field :main_image
    %tr
      %th= f.label :publish_start_at, 'イベントページ公開日時'
      %td= f.datetime_field :publish_start_at
    %tr
      %th= f.label :exhibit_submit_start_at, '出展情報申込開始日時'
      %td= f.datetime_field :exhibit_submit_start_at
    %tr
      %th= f.label :exhibit_submit_end_at, '出展情報申込締切日時'
      %td= f.datetime_field :exhibit_submit_end_at
  

  - if @event.errors.any?
    #error_explanation
      %h2= "#{pluralize(@event.errors.count, "error")} prohibited this admin_event from being saved:"
      %ul
        - @event.errors.full_messages.each do |message|
          %li= message

  .actions
    = f.submit '作成する'
