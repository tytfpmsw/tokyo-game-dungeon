.card.shadow.mt-3
  .card-header
    = icon_with_text("table", "一覧")
  .card-body.mx-3
    = turbo_frame_tag "place-block-list", data: { turbo_action: :advance } do
      .row.py-2
        .col-4.mt-auto
          = sort_link(@search, :name, "ブロック名")
        .col-4.mt-auto
          = sort_link(@search, :capacity, "ブース数")
        .col-4.d-flex.justify-content-end
          = button_to "新規作成", new_admin_floor_place_block_path(@floor), method: :get, class: "btn btn-primary", data: { turbo_frame: "modal" }

      #place-blocks
        = turbo_frame_tag "place-blocks-page-#{@place_blocks.current_page}" do
          = render @place_blocks
          = turbo_frame_tag "place-blocks-page-#{@place_blocks.next_page}"
  
  .d-flex.justify-content-end.mt-3
    = paginate @place_blocks