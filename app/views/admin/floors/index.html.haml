.breadcrumb
  %li.breadcrumb-item
    = link_to "管理者トップ", admin_root_path
  %li.breadcrumb-item
    = link_to "イベント一覧", admin_events_path
  %li.breadcrumb-item
    = link_to @event.name, admin_event_path(@event)
  %li.breadcrumb-item
    = link_to "開催日程一覧", admin_event_event_schedules_path(@event) 
  %li.breadcrumb-item.active
    フロア一覧

%h4.fw-bold
  %span
    #{@event.name} #{@event_schedule.day_number_in_event}日目 フロア一覧

.card.shadow.mt-3
  .card-header
    = icon_with_text("table", "一覧")
  .card-body.mx-3
    = turbo_frame_tag "floor-list", data: { turbo_action: :advance } do
      .row.py-2
        .col-4.mt-auto
          フロア名
        .col-4.mt-auto
          画像
        .col-4.d-flex.justify-content-end
          = button_to "新規作成", new_admin_event_schedule_floor_path(@event_schedule), method: :get, class: "btn btn-primary", data: { turbo_frame: "modal" }

      #floors
        = render @floors