= bootstrap_form_with(model: [:admin, @event_schedule, floor], data: { action: "turbo:submit-end->modal#close"}) do |form|
  = form.text_field :name, value: floor.name, :placeholder => "例：３階"
  = form.file_field :image, value: floor.image
  - if floor.errors.any?
    #error_explanation
      %h2= "#{floor.errors.count}個のエラーで保存できませんでした:"
      %ul
        - floor.errors.full_messages.each do |message|
          %li= message
  = form.primary
