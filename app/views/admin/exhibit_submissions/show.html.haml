%h1 提出情報の詳細

%table
  %thead
    %tr
      %th 出展者
      %th タイトル
      %th 説明
      %th 動画URL
  %tbody
    %tr
      %td= @exhibit_submission.exhibitor.name
      %td= @exhibit_submission.exhibit_title
      %td= @exhibit_submission.exhibit_description
      %td= @exhibit_submission.exhibit_movie_url

= form_with url: admin_exhibit_submissions_url do |f|
  %div
    = f.submit '承認', formaction: approve_admin_exhibit_submission_path(@exhibit_submission)
    = f.submit '却下', formaction: reject_admin_exhibit_submission_path(@exhibit_submission)
