%h1 提出情報の詳細

%table
  %thead
    %tr
      %th 出展者
      %th サークル名
      %th タイトル
      %th ジャンル
      %th 説明
      %th VR使用
      %th 動画URL
      %th 画像
      %th 原作タイトル
  %tbody
    %tr
      %td= @exhibitor.name
      %td= @exhibit_submission.circle_name
      %td= @exhibit_submission.title
      %td= @exhibit_submission.human_attribute_enum(:genre)
      %td= @exhibit_submission.description
      %td= @exhibit_submission.is_vr
      %td= @exhibit_submission.movie_url
      %td= image_tag @exhibit_submission.image.url, width: 200
      %td= @exhibit_submission.original_work

= form_with url: admin_event_exhibit_submissions_url do |f|
  %div
    = f.submit '承認', formaction: approve_admin_event_exhibit_submission_path(@exhibit_submission.exhibit_information.event, @exhibit_submission)
    = f.submit '却下', formaction: reject_admin_event_exhibit_submission_path(@exhibit_submission.exhibit_information.event, @exhibit_submission)
