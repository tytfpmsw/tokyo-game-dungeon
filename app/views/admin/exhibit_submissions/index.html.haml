.p-admin-home
  %h1 未確認の出展情報一覧
  %table
    %thead
      %tr
        %th 出展者
        %th 確認
    %tbody
      - @exhibit_submissions.each do |exhibit_submission|
        %tr
          %td= exhibit_submission.exhibit_information.circle_name
          %td= link_to '確認', exhibitor_event_exhibit_submission_path(@event, exhibit_submission)
