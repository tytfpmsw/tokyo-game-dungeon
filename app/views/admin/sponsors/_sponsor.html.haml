= turbo_frame_tag sponsor do
  .row.py-2.border-top
    .col-3.my-auto
      = sponsor.name
    .col-3.my-auto
      = sponsor.image.present? ? image_tag(sponsor.image.url, size: "100x100") : "No Image"
    .col-3.my-auto
      = sponsor.url.present? ? link_to(sponsor.url, sponsor.url) : "No URL"
    .col-3
      .d-flex.justify-content-end
        = link_to icon_with_text("pencil", "編集"), edit_admin_sponsor_path(sponsor), class: "btn btn-outline-primary", data: { turbo_frame: "modal" }
        = button_to "削除", admin_sponsor_url(sponsor), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "本当に削除しますか？", turbo_frame: "sponsors" }