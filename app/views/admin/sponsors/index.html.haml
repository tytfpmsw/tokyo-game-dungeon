.card.shadow.mt-3
  .card-header
    = icon_with_text("table", "一覧")
  .card-body.mx-3
    = turbo_frame_tag "sponsor-list", data: { turbo_action: :advance } do
      .row.py-2
        .col-3.mt-auto
          = sort_link(@search, :name, "団体名")
        .col-3.mt-auto
          画像
        .col-3.mt-auto
          = sort_link(@search, :url, "URL")
        .col-3.d-flex.justify-content-end
          = button_to "新規作成", new_admin_sponsor_path, method: :get, class: "btn btn-primary", data: { turbo_frame: "modal" }

      #sponsors
        = turbo_frame_tag "sponsors-page-#{@sponsors.current_page}" do
          = render @sponsors
          = turbo_frame_tag "sponsors-page-#{@sponsors.next_page}", loading: :lazy, src: path_to_next_page(@sponsors)
  
  .d-flex.justify-content-end.mt-3
    = paginate @sponsors