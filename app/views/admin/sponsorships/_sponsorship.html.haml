= turbo_frame_tag sponsorship do
  .row.py-2.border-top
    .col-3.my-auto
      = sponsorship.sponsor.name
    .col-3.my-auto
      = sponsorship.sponsor.image.present? ? image_tag(sponsorship.sponsor.image.url, size: "100x100") : "No Image"
    .col-3.my-auto
      = sponsorship.sponsor.url.present? ? link_to(sponsorship.sponsor.url, sponsorship.sponsor.url) : "No URL"
    .col-3
      .d-flex.justify-content-end
        = button_to "スポンサーを変更", edit_admin_event_sponsorship_path(@event, sponsorship), method: :get, class: "btn btn-outline-primary", data: { turbo_frame: "modal" }
        = button_to "削除", admin_event_sponsorship_path(@event, sponsorship), method: :delete, data: { confirm: "削除しますか？" }, class: "btn btn-outline-danger"