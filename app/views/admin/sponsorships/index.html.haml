%h4.fw-bold
  %span #{@event.name}の協賛一覧

.card.shadow.mt-3
  .card-header
    = icon_with_text("table", "一覧")
  .card-body.mx-3
    = turbo_frame_tag "sponsorship-list", data: { turbo_action: :advance } do
      .row.py-2
        .col-3.mt-auto
          団体名
        .col-3.mt-auto
          画像
        .col-3.mt-auto
          URL
        .col-3.d-flex.justify-content-end
          = link_to icon_with_text("plus-circle", "協賛を追加"), new_admin_event_sponsorship_path(@event), class: "btn btn-primary", data: { turbo_frame: "modal" }

      #sponsor-ships
        = render @sponsors
