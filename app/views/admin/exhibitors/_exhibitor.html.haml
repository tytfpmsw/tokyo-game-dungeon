= turbo_frame_tag exhibitor do
  .row.py-2.border-top
    .col-2.my-auto
      = exhibitor.email
    .col-2.my-auto
      = exhibitor.name
    .col-2.my-auto
      = exhibitor.discord_name
    .col-2.my-auto
      = exhibitor.human_attribute_enum(:exhibitor_type)
    .col-2.my-auto
      = button_to "リセットする", regenerate_password_admin_event_exhibitor_path(@event, exhibitor), method: :patch, class: "btn btn-outline-primary", data: { turbo_confirm: "#{exhibitor.name}さんのパスワードをリセットして本人にメールを送信します。よろしいですか？", turbo_frame: "exhibitors" }
    .col-2.d-flex.justify-content-end
      = link_to "編集", edit_admin_event_exhibitor_path(@event, exhibitor), class: "btn btn-outline-primary", data: { turbo_frame: "modal" }
      = button_to "削除", admin_event_exhibitor_url(@event, exhibitor), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "このイベントに紐づけたこの出展者の出展情報も同時に削除されます。本当にイベントから削除しますか？", turbo_frame: "exhibitors" }