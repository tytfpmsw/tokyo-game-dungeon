.p-admin-exhibitor-index
  %h4.fw-bold
    %span #{@event.name_ja} 出展者一覧

  .card.shadow.mt-3
    .card-header
      =icon_with_text("search", "検索条件")
    .card-body
      =search_form_for(@search, url: admin_event_exhibitors_path(@event), html: { data: { turbo_frame: "exhibitors", controller: "search_form", action: "input->search_form#submit" } }) do |f|
        .row.g3.mb-3
          .col-2.col-xl-2
            =f.label :name_cont, "出展者名", class: "form-label"
            =f.search_field :name_cont, class: "form-control"
          .col-2.col-xl-2
            =f.label :email_cont, "メールアドレス", class: "form-label"
            =f.search_field :email_cont, class: "form-control"
          .col-2.col-xl-2
            =f.label :discord_name_cont, "Discordユーザー名", class: "form-label"
            =f.search_field :discord_name_cont, class: "form-control"
          .col-2.col-xl-2
            = f.submit
          .col-2.d-flex.align-items-end
            =link_to "クリア", admin_event_exhibitors_path(@event), class: "btn btn-outline-secondary", method: :get
  
  .card.shadow.mt-3
    .card-header
      = icon_with_text("table", "一覧")
    .card-body.mx-3
      =turbo_frame_tag "exhibitor-list", data: { turbo_action: :advance } do
        .row.py-2
          .col-3.mt-auto
            =sort_link(@search, :name, "出展者名")
          .col-3.mt-auto
            =sort_link(@search, :email, "メールアドレス")
          .col-3.mt-auto
            =sort_link(@search, :discord_name, "Discordユーザー名")
          .col-3.d-flex.justify-content-end
            =link_to icon_with_text("plus-circle", "出展者を追加"), new_admin_event_exhibitor_path(@event), class: "btn btn-primary", data: { turbo_frame: "modal" }

    .card-body.mx-3
      =turbo_frame_tag "exhibitors", data: { turbo_action: :advance} do
        #exhibitors
          =turbo_frame_tag "exhibitor-page-#{@exhibitors.current_page}" do
            =render @exhibitors
            =turbo_frame_tag "exhibitor-page-#{@exhibitors.next_page}"
    
    .d-flex.justify-content-end.mt-3
      =paginate @exhibitors
