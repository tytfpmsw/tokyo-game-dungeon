= bootstrap_form_with(url: admin_event_exhibitors_url, data: { action: "turbo:submit-end->modal#close"}) do |form|
  = form.email_field :email
  = form.text_field :name
  = form.text_field :discord_name
  = form.select :exhibitor_type, Exhibitor.exhibitor_types.keys.map { |k| [t("activerecord.attributes.exhibitor/exhibitor_type.#{k}"), k] }
  = form.primary
