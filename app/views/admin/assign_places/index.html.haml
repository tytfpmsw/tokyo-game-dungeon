.breadcrumb
  %li.breadcrumb-item
    = link_to "管理者トップ", admin_root_path
  %li.breadcrumb-item
    = link_to "イベント一覧", admin_events_path
  %li.breadcrumb-item
    = link_to @place_block.event.name, admin_event_path(@place_block.event)
  %li.breadcrumb-item
    = link_to "開催日程一覧", admin_event_event_schedule_path(@place_block.event, @place_block.event_schedule)
  %li.breadcrumb-item
    = link_to "フロア一覧", admin_event_schedule_floors_path(@place_block.event_schedule)
  %li.breadcrumb-item.active
    = @place_block.name

%h4.fw-bold
  %span
    #{@place_block.event.name} #{@place_block.event.event_schedules.index(@place_block.event_schedule) + 1}日目 #{@place_block.floor.name} #{@place_block.name}ブロック 場所割り当て

.card.shadow.mt-3
  .card-header
    = icon_with_text("table", "一覧")
  .card-body.mx-3
    = turbo_frame_tag "place-list", data: { turbo_action: :advance } do
      .row.py-2
        .col-3.mt-auto
          ブロック名
        .col-3.mt-auto 
          番号
        .col-3.mt-auto
          出展作品名

      #places
        = for i in 0..@place_block.capacity.size - 1 do
          - if @exhibit_information_places.where(place_block: @place_block, place_number: i + 1).exists?
            = render "place", { floor: @floor, place_block: @place_block, number: i + 1, exhibit_information_title: @exhibit_information_places.find_by(place_block: @place_block, place_number: i + 1).exhibit_information.title }
          
            