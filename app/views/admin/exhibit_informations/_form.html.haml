= bootstrap_form_with(model: [:admin, @event, exhibit_information], data: { action: "turbo:submit-end->modal#close"}) do |form|
  = form.text_field :circle_name, value: exhibit_submission.circle_name
  = form.text_field :title, value: exhibit_submission.title
  = form.select :genre, ExhibitInformation.genres.keys.map { |k| [t("activerecord.attributes.genre.#{k}"), k] }, selected: exhibit_submission.genre
  = form.text_area :description, value: exhibit_submission.description
  - if exhibit_submission.is_vr
    = form.check_box :is_vr, checked: true
  - else
    = form.check_box :is_vr
  = form.text_field :movie_url, value: exhibit_submission.movie_url
  = form.file_field :image
  = form.text_field :original_work, value: exhibit_submission.original_work
  - if exhibit_submission.errors.any?
    #error_explanation
      %h2= "#{exhibit_submission.errors.count}個のエラーで保存できませんでした:"
      %ul
        - exhibit_submission.errors.full_messages.each do |message|
          %li= message
  = form.primary
