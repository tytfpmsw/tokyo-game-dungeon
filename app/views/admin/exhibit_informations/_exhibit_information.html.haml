= turbo_frame_tag exhibit_information do
  .row.py-2.border-top
    .col-2.my-auto
      - if exhibit_information.exhibit_submission.status_submitted?
        = button_to "確認", admin_exhibit_submission_path(exhibit_information.exhibit_submission), class: "btn btn-outline-primary", data: { turbo_frame: "_top" }
      - else
        
    .col-2.my-auto
      = exhibit_information.exhibitor.name
    .col-2.my-auto
      = exhibit_information.circle_name
    .col-2.my-auto
      = exhibit_information.title
    .col-2.my-auto
      = exhibit_information.image.present? ? image_tag(exhibit_information.image, size: "100x100") : "未設定"
    .col-2.my-auto
      .d-flex.justify-content-end
        = link_to "編集", edit_admin_event_exhibit_information_path(exhibit_information.event.id, exhibit_information), class: "btn btn-outline-primary", data: { turbo_frame: "modal" }
