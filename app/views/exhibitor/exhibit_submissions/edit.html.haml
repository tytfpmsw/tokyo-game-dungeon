.breadcrumb
  %li.breadcrumb-item
    = link_to "出展者トップページ", exhibitor_root_path
  %li.breadcrumb-item
    = link_to @event.name, exhibitor_event_path(@event.url_subdirectory)
  %li.breadcrumb-item.active
    出展情報の提出

