.p-exhibitor-exhibit-submission-form
  %h1 出展情報の提出

  = bootstrap_form_with url: exhibitor_event_exhibit_submission_path, model: @exhibit_submission, method: :patch do |f|
    %table
      %tr
        %td= f.text_field :circle_name, value: @exhibit_submission&.circle_name, help: '50文字以内'
      %tr
        %td= f.text_field :title, value: @exhibit_submission&.title, help: '50文字以内'
      %tr
        %td= f.select :genre, ExhibitInformation.genres.keys.map { |k| [t("activerecord.attributes.genre.#{k}"), k] }, selected: @exhibit_submission&.genre
      %tr
        %td= f.text_area :description, value: @exhibit_submission&.description, help: '100文字以内'
      %tr
        %td= f.text_field :title_url, value: @exhibit_submission&.title_url
      %tr
        %td= f.text_field :steam_url, value: @exhibit_submission&.steam_url
      %tr
        %td= f.text_field :twitter_url, value: @exhibit_submission&.twitter_url
      %tr
        %td= f.text_field :movie_url, value: @exhibit_submission&.movie_url
      %tr
        %td= f.file_field :image, help: '画像に変更がない場合はアップロードは不要です。'
      %tr
        %td= f.text_field :original_work, value: @exhibit_submission&.original_work, help: '二次創作の作品を出展する場合は、原作のタイトルを50未字以内で記入してください。'
      %tr
        %td= f.text_area :memo, value: @exhibit_submission&.memo, help: '他の出展者と展示スペースを連結したい、大型の機器を持ち込む場合などは100文字以内でご記入ください。'
      %tr
        %td= f.select :delivery_usage_scale, ExhibitInformation.delivery_usage_scales.keys.map { |k| [t("activerecord.attributes.delivery_usage_scale.#{k}"), k] }, selected: @exhibit_submission&.delivery_usage_scale
      %tr
        - if @exhibit_submission&.is_vr
          %td
            = f.check_box :is_vr, value: @exhibit_submission&.is_vr, checked: true
            VRの出展の場合はチェックしてください。
        - else
          %td
            = f.check_box :is_vr, value: @exhibit_submission&.is_vr
            VRの出展の場合はチェックしてください。
      - if @exhibit_submission.errors.any?
        #error_explanation
          %ul
            - @exhibit_submission.errors.full_messages.each do |message|
              %li.validation-error= message
    .submit-buttons
      = f.submit '提出する', class: 'btn btn-primary'
