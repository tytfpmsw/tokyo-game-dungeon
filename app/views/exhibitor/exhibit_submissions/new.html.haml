%h1 出展情報の提出

= form_with url: exhibitor_exhibit_submissions_path do |f|
  %div
    = f.label :title, 'タイトル'
    = f.text_field :title
  %div
    = f.label :description, '説明'
    = f.text_area :description
  %div
    = f.label :movie_url, '動画URL'
    = f.text_field :movie_url
  %div
    = f.submit '提出する'
