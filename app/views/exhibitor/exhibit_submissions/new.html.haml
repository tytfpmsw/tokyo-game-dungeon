.p-exhibitor-exhibit-submission-new
  %h1 出展情報の提出

  = form_with url: exhibitor_exhibit_submissions_path do |f|
    %table
      %tr
        %th= f.label :title, 'タイトル'
        %td= f.text_field :title, value: @exhibit_information&.title
      %tr
        %th= f.label :description, '説明'
        %td= f.text_area :description, value: @exhibit_information&.description
      %tr
        %th= f.label :movie_url, '動画URL'
        %td= f.text_field :movie_url, value: @exhibit_information&.movie_url
    .submit-buttons
      = f.submit '提出する'

