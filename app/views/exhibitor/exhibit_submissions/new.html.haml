.p-exhibitor-exhibit-submission-new
  %h1 出展情報の提出

  = form_with url: exhibitor_event_exhibit_submissions_path do |f|
    %table
      %tr
        %th= f.label :circle_name, 'サークル名'
        %td= f.text_field :circle_name, value: @exhibit_submission&.circle_name
      %tr
        %th= f.label :title, 'タイトル'
        %td= f.text_field :title, value: @exhibit_submission&.title
      %tr
        %th= f.label :description, '説明'
        %td= f.text_area :description, value: @exhibit_submission&.description
      %tr
        %th= f.label :movie_url, '動画URL'
        %td= f.text_field :movie_url, value: @exhibit_submission&.movie_url
      %tr
        %th= f.label :image, '画像'
        %td= f.file_field :image
      - if @exhibit_submission&.errors&.any?
        #error_explanation
          %ul
            - @exhibit_submission.errors.full_messages.each do |message|
              %li.validation-error= message
    .submit-buttons
      = f.submit '提出する'

