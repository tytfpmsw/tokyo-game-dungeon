.p-exhibitor-home
  .exhibitor-home-header
    %h1 東京ゲームダンジョン_出展者用ページ
    .exhibitor-information 
      %h2 ようこそ #{@exhibitor.name} さん
      .exhibitor-information-events
        - if @events.empty?
          %p 現在出展受付中のイベントはありません。
        - else
          - @events.each do |event|
            link_to event.name_ja, exhibitor_event_exhibit_submissions_path(event)

