.breadcrumb
  %li.breadcrumb-item
    = link_to "出展者トップページ", exhibitor_root_path
  %li.breadcrumb-item.active
    パスワードの再設定

.container.p-5
  .row
    .col-md-12
      %h5 パスワードの再設定
      = form_tag exhibitor_password_path, method: :patch do
        .form-group
          = label_tag :password, '新しいパスワード'
          = password_field_tag :password, nil, class: 'form-control'
        .form-group
          = label_tag :password_confirmation, '新しいパスワード（確認）'
          = password_field_tag :password_confirmation, nil, class: 'form-control'
        .form-group
          = submit_tag '更新', class: 'btn btn-primary'