@startuml class
class event
class event_interview
class event_schedule
class exhibit_information
class exhibit_submission
class exhibitor
class floor
class place_block
class sponsor
class sponsorship

event "1" -- "1..*" event_schedule
event "1" -- "0..*" event_interview
event_schedule "1" -- "0..*" floor
floor "1" -- "0..*" place_block
exhibit_information "1" -- "1" exhibit_submission
exhibit_information "1" -- "1" exhibitor
event "1" -- "0..*" sponsorship
sponsorship "0..*" -- "1" sponsor
event "1" -- "0..*" exhibit_information
exhibit_information --> place_block
@enduml